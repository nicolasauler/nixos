+def _allowlist_from_env(name: str) -> frozenset[str]:
+    """Parse a comma-separated env var into a lowercased set. Empty = no filter."""
+    return frozenset(
+        entry.strip().lower()
+        for entry in os.environ.get(name, "").split(",")
+        if entry.strip()
+    )
+
+
+def _flag_from_env(name: str, *, default: bool) -> bool:
+    raw = os.environ.get(name, "").strip().lower()
+    if not raw:
+        return default
+    return raw not in {"0", "false", "no", "off"}
+
+
+# Read once at import time; the master must be restarted to pick up changes.
+PR_AUTHOR_ALLOWLIST = _allowlist_from_env("BUILDBOT_PR_AUTHORS")
+BUILD_PUSHES = _flag_from_env("BUILDBOT_BUILD_PUSHES", default=True)
+
+
+def pr_author_allowed(author: str | None) -> bool:
+    """Whether a pull-request change's author is allowed to trigger builds.
+
+    For pull-request changes the forge hooks record the bare login as the
+    author (e.g. "nicolasauler"), unlike push changes which carry a git
+    identity ("Nicolas Auler <nicolas@example.com>"), so an exact
+    case-insensitive match is unambiguous here. An empty allowlist preserves
+    upstream behaviour: every pull request builds.
+    """
+    if not PR_AUTHOR_ALLOWLIST:
+        return True
+    return (author or "").strip().lower() in PR_AUTHOR_ALLOWLIST
+
